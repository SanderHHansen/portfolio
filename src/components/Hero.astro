---
import { intro } from "@/data/intro";
---

<section id="about" class="scroll-mt-24 py-16 sm:py-20">
  <div data-reveal class="max-w-3xl">
    <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase sm:text-sm">
      {intro.role}
    </p>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight text-ink sm:text-6xl">
      {intro.name}
    </h1>
    <p class="mt-4 font-mono text-sm text-muted">{intro.location}</p>
    <div class="mt-8 max-w-2xl space-y-4 text-base leading-relaxed text-muted sm:text-lg">
      {intro.description.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      {
        intro.links.map((link, index) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            class:list={[
              "rounded-full border px-5 py-2.5 text-sm transition-colors duration-200",
              index === 0
                ? "border-accent/40 bg-accent/10 text-accent hover:bg-accent/20"
                : "border-line text-muted hover:border-muted/50 hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
