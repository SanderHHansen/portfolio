---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<section id={id} class="scroll-mt-24 border-t border-line py-20 sm:py-24">
  <div data-reveal class="mb-12 max-w-2xl">
    {
      eyebrow && (
        <p class="mb-3 font-mono text-xs tracking-[0.2em] text-accent uppercase">{eyebrow}</p>
      )
    }
    <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {title}
    </h2>
    {description && <p class="mt-4 text-base leading-relaxed text-muted">{description}</p>}
  </div>
  <slot />
</section>
