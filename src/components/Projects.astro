---
import { projects } from "@/data/projects";
import Section from "./Section.astro";
import { withBase } from "@/utils/paths";
---

<Section
  id="projects"
  eyebrow="Work"
  title="Selected projects"
  description="Things I have built. Each one links to its source on GitHub and, where available, a live version."
>
  <ul class="grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <li
          data-reveal
          class="group flex flex-col overflow-hidden rounded-xl border border-line bg-surface/60 transition-colors duration-200 hover:border-muted/40"
        >
          <a href={project.liveUrl} target="_blank" rel="noreferrer" class="flex flex-1 flex-col">
            <div class="aspect-video overflow-hidden border-b border-line bg-canvas">
              <img
                src={withBase(project.image)}
                alt={project.imageAlt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </div>
            <div class="flex-1 p-6">
              <h3 class="text-lg font-medium text-ink">{project.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{project.description}</p>
            </div>
          </a>
          <div class="flex items-center justify-between gap-4 border-t border-line px-6 py-4">
            <ul class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="rounded-full border border-line px-2.5 py-1 font-mono text-[0.7rem] text-muted">
                  {tag}
                </li>
              ))}
            </ul>
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={`${project.name} on GitHub`}
              class="shrink-0 text-muted transition-colors hover:text-ink"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.11-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.66.42.36.79 1.07.79 2.16v3.2c0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
              </svg>
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
