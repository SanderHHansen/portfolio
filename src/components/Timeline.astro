---
import { publications } from "@/data/publications";
import { timeline } from "@/data/timeline";
import Section from "./Section.astro";
import TimelineList from "./TimelineList.astro";

const work = timeline.filter((entry) => entry.type === "work");
const education = timeline.filter((entry) => entry.type === "education");
---

<Section
  id="timeline"
  eyebrow="Background"
  title="Experience & education"
  description="My professional experience and formal education"
>
  <div class="space-y-16">
    <div>
      <h3 class="mb-8 font-mono text-xs tracking-[0.2em] text-muted uppercase">Work experience</h3>
      <TimelineList entries={work} />
    </div>
    <div>
      <h3 class="mb-8 font-mono text-xs tracking-[0.2em] text-muted uppercase">Education</h3>
      <TimelineList entries={education} />
      {
        publications.length > 0 && (
          <div class="mt-12">
            <h4 class="mb-4 font-mono text-xs tracking-[0.2em] text-muted uppercase">
              Publications
            </h4>
            <ul class="space-y-3">
              {publications.map((publication) => (
                <li>
                  <a
                    href={publication.url}
                    target="_blank"
                    rel="noreferrer"
                    class="group block max-w-2xl text-sm text-ink transition-colors hover:text-accent"
                  >
                    <span class="inline-flex items-center gap-2">
                      <span class="underline decoration-line underline-offset-4 group-hover:decoration-current">
                        {publication.title}
                      </span>
                      <svg
                        viewBox="0 0 24 24"
                        width="14"
                        height="14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <path d="M15 3h6v6" />
                        <path d="M10 14 21 3" />
                      </svg>
                    </span>
                    {publication.description && (
                      <span class="mt-1 block text-muted">{publication.description}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</Section>
